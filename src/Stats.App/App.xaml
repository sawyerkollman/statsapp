<Application x:Class="Stats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge order matters: StaticResource resolves in parse order, and later dictionaries reference
                 the palette from Theme.xaml. tools/Stats.UiPreview merges this exact sequence so previews
                 resolve resources identically to production (see Views/AppStyles.xaml). -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stats.App;component/Views/Theme.xaml"/>
                <!-- Controls.xaml owns the hand-rolled implicit styles/templates for ScrollBar, Slider,
                     ProgressBar, ComboBox/ComboBoxItem, ContextMenu/MenuItem, CheckBox/RadioButton, and
                     Expander — merged after Theme.xaml (palette) and before TileTemplates.xaml (tile-specific
                     content) per docs/superpowers/specs/2026-08-27-v1.7-trust-polish-design.md. -->
                <ResourceDictionary Source="pack://application:,,,/Stats.App;component/Views/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Stats.App;component/Views/TileTemplates.xaml"/>
                <!-- App-level text / TextBox / TabControl / ToolTip styles (formerly declared inline here). -->
                <ResourceDictionary Source="pack://application:,,,/Stats.App;component/Views/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
