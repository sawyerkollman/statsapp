<Application x:Class="Stats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Stats.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <SolidColorBrush x:Key="WindowBg" Color="#FF1B1B1C"/>
            <SolidColorBrush x:Key="TileBg" Color="#FF252528"/>
            <SolidColorBrush x:Key="FlyoutBg" Color="#FF2B2B2F"/>
            <SolidColorBrush x:Key="ControlBg" Color="#FF303035"/>
            <SolidColorBrush x:Key="BorderDim" Color="#FF3A3A40"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFF0F0F0"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9A9E"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFE68A2E"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#FFE6A23C"/>
            <SolidColorBrush x:Key="CritBrush" Color="#FFE05A4F"/>
            <SolidColorBrush x:Key="GaugeTrack" Color="#FF3A3A40"/>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
            <conv:TileSizeToLengthConverter x:Key="TileSizeToLength"/>
            <conv:HeatToBrushConverter x:Key="HeatToBrush"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:EqualsConverter x:Key="Equals"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:OverlayOrientationConverter x:Key="OverlayOrientation"/>

            <!-- Text -->
            <Style TargetType="TextBlock" x:Key="GroupHeader">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="8,14,0,4"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="SettingsHeader">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,6"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="SettingsLabel">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>

            <!-- Dark control styles -->
            <Style TargetType="Button" x:Key="HeaderButton">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Background" Value="{StaticResource TileBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource ControlBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDim}"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Padding="12,6" Margin="0,0,4,0" CornerRadius="4,4,0,0" Background="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{StaticResource TextSecondary}"
                                                  TextElement.FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource TileBg}"/>
                                    <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource FlyoutBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDim}"/>
            </Style>
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{StaticResource FlyoutBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderDim}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
