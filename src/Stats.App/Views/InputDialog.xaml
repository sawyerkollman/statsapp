<Window x:Class="Stats.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource FlyoutBg}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
        <TextBox x:Name="Input" FontSize="13"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource HeaderButton}" MinWidth="70"/>
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Style="{StaticResource HeaderButton}" MinWidth="70"/>
        </StackPanel>
    </StackPanel>
</Window>
