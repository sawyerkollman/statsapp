<Window x:Class="Stats.App.Views.GamingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Stats — Gaming" Width="620" Height="460" MinWidth="460" MinHeight="360" Background="{DynamicResource WindowBg}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="Gaming" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/><WrapPanel DockPanel.Dock="Right"><Button Content="Sessions" Command="{Binding OpenGamingSessionsCommand}" Style="{StaticResource HeaderButton}"/><Button Content="Gaming options" Command="{Binding OpenLabOptionsCommand}" Style="{StaticResource HeaderButton}"/></WrapPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,16,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="Active game" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Column="1" Text="{Binding GamingActiveGame}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <TextBlock Grid.Row="1" Text="Capture" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GamingCaptureStatus}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
   <TextBlock Grid.Row="2" Text="FPS" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GamingFpsText}" Foreground="{DynamicResource TextPrimary}" FontSize="28" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
   <TextBlock Grid.Row="3" Text="Profile" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GamingProfile}" Foreground="{DynamicResource TextPrimary}"/>
   <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0,16,0,0" Padding="12" Background="{DynamicResource TileBg}" CornerRadius="8"><StackPanel><TextBlock Text="Latest report" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="{Binding PostGameReportText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxHeight="68"/><Button Content="Open latest report" Command="{Binding OpenPostGameReportCommand}" IsEnabled="{Binding HasPostGameReport}" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="2">
   <TextBlock Text="{Binding GamingRecordingStatus}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding GamingRecordingError}" Foreground="{DynamicResource CritBrush}" TextWrapping="Wrap"/>
   <WrapPanel><Button Content="Start recording" Command="{Binding StartGamingRecordingCommand}" IsEnabled="{Binding GamingCanStart}"/><Button Content="Stop / finalize" Command="{Binding StopGamingRecordingCommand}" IsEnabled="{Binding GamingCanStop}"/><TextBlock Text="{Binding GamingRecording, StringFormat=Recording: {0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
