<Window x:Class="Stats.App.Views.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Stats.App.Controls"
        Title="Stats — Comparison" Width="760" Height="640" MinWidth="520" MinHeight="360"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Freeze" Command="{Binding FreezeCommand}" Style="{StaticResource HeaderButton}" Margin="0,0,6,0" IsEnabled="{Binding IsLive}"/>
                <Button Content="Resume live" Command="{Binding ResumeCommand}" Style="{StaticResource HeaderButton}" IsEnabled="{Binding IsLive}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}">
                    <Run Text="Shared UTC timeline: "/><Run Text="{Binding AxisStartUtc, StringFormat={}{0:u}}"/><Run Text=" — "/><Run Text="{Binding AxisEndUtc, StringFormat={}{0:u}}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding IsLive}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Metrics (up to four):" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AvailableMetrics}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource TileBg}" CornerRadius="{StaticResource RadiusPanel}" Padding="10" Margin="0,0,0,8">
                            <DockPanel Height="130">
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                </DockPanel>
                                <ctl:HistoryChart Values="{Binding Values}" TimesUtc="{Binding TimesUtc}" Unit="{Binding Unit}"
                                                  YAxisLabels="{Binding YAxisLabels}" TimeAxisLabels="{Binding TimeAxisLabels}" Stroke="{DynamicResource AccentBrush}"
                                                  AxisStartUtc="{Binding DataContext.AxisStartUtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  AxisEndUtc="{Binding DataContext.AxisEndUtc, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CursorTimeUtc="{Binding DataContext.CursorTimeUtc, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
