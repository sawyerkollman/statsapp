<Window x:Class="Stats.App.Views.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Stats — Overlay editor" Width="900" Height="650" MinWidth="640" MinHeight="460"
        Background="{DynamicResource WindowBg}" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources><Style x:Key="TransparentThumb" TargetType="primitives:Thumb"><Setter Property="Focusable" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:Thumb"><Border x:Name="FocusBorder" Background="Transparent"/><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="FocusBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
        <Border Background="#E01B1B1C" BorderBrush="{DynamicResource BorderDim}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0"><ScrollViewer x:Name="CanvasHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Width="1920" Height="1080" Background="#22101010"><Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Canvas.LayoutTransform><Line X1="{Binding GuideX}" X2="{Binding GuideX}" Y1="0" Y2="1080" Stroke="{DynamicResource AccentBrush}" StrokeDashArray="4,4" IsHitTestVisible="False" Visibility="{Binding ShowVerticalGuide, Converter={StaticResource BoolToVis}}"/><Line Y1="{Binding GuideY}" Y2="{Binding GuideY}" X1="0" X2="1920" Stroke="{DynamicResource AccentBrush}" StrokeDashArray="4,4" IsHitTestVisible="False" Visibility="{Binding ShowHorizontalGuide, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Width="{Binding Width}" Height="{Binding Height}"><Border Background="#E01B1B1C" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource OverlayTextSecondary}"/><TextBlock Text="{Binding Tile.CurrentText}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource OverlayTextPrimary}"/></StackPanel></Border><primitives:Thumb Style="{StaticResource TransparentThumb}" AutomationProperties.Name="{Binding Label, StringFormat=Move {0} card}" GotKeyboardFocus="Thumb_GotKeyboardFocus" DragStarted="Thumb_DragStarted" DragCompleted="Thumb_DragCompleted" DragDelta="MoveThumb_DragDelta"/><primitives:Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="Thumb_DragStarted" DragCompleted="Thumb_DragCompleted" DragDelta="ResizeThumb_DragDelta" Background="{DynamicResource AccentBrush}"/></Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Canvas>
        </ScrollViewer></Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Overlay canvas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/><TextBlock Text="Drag cards or use arrow keys. Geometry snaps to 8 pixels." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/><TextBlock Text="Zoom" Foreground="{DynamicResource TextSecondary}"/><Slider Minimum="0.1" Maximum="1" Value="{Binding Zoom, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="Canvas zoom"/><Button Content="Fit to viewport" Click="Fit_Click" Style="{StaticResource HeaderButton}" Margin="0,4,0,0"/>
            <ComboBox ItemsSource="{Binding AvailableMetrics}" SelectedItem="{Binding SelectedMetric}" DisplayMemberPath="DisplayName"/><Button Content="Add metric" Command="{Binding AddSelectedCommand}" Style="{StaticResource HeaderButton}" Margin="0,4,0,0"/><Button Content="Remove selected" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource HeaderButton}" Margin="0,4,0,0"/>
            <CheckBox Content="Fixed neon border" IsChecked="{Binding FixedNeonBorder, Mode=OneWay}" Command="{Binding ToggleNeonBorderCommand}" Margin="0,10,0,0"/>
            <TextBlock Text="Selected cards" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,2"/><ListBox ItemsSource="{Binding Slots}" DisplayMemberPath="Label" SelectionMode="Multiple" SelectionChanged="Cards_SelectionChanged" Height="100" Background="{DynamicResource TileBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDim}" AutomationProperties.Name="Overlay cards (Ctrl selects multiple)"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/></Style></ListBox.ItemContainerStyle></ListBox>
            <Grid DataContext="{Binding SelectedSlot}" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="X" Foreground="{DynamicResource TextSecondary}"/><TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Numeric_GotKeyboardFocus" LostKeyboardFocus="Numeric_LostKeyboardFocus" AutomationProperties.Name="Card X position"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Y" Foreground="{DynamicResource TextSecondary}"/><TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Numeric_GotKeyboardFocus" LostKeyboardFocus="Numeric_LostKeyboardFocus" AutomationProperties.Name="Card Y position"/></StackPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="Width" Foreground="{DynamicResource TextSecondary}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Numeric_GotKeyboardFocus" LostKeyboardFocus="Numeric_LostKeyboardFocus" AutomationProperties.Name="Card width"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Height" Foreground="{DynamicResource TextSecondary}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="Numeric_GotKeyboardFocus" LostKeyboardFocus="Numeric_LostKeyboardFocus" AutomationProperties.Name="Card height"/></StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0"><Button Content="Align left" Command="{Binding AlignLeftCommand}" Style="{StaticResource HeaderButton}"/><Button Content="Align top" Command="{Binding AlignTopCommand}" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/><Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/><Button Content="Redo" Command="{Binding RedoCommand}" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/></WrapPanel><WrapPanel Margin="0,4,0,0"><Button Content="Compact" Command="{Binding CompactCommand}" Style="{StaticResource HeaderButton}"/><Button Content="Analysis" Command="{Binding AnalysisCommand}" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/><Button Content="Synthwave" Command="{Binding SynthwaveCommand}" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/></WrapPanel>
            <WrapPanel Margin="0,8,0,0"><Button Content="Export canvas…" Click="Export_Click" Style="{StaticResource HeaderButton}"/><Button Content="Import canvas…" Click="Import_Click" Style="{StaticResource HeaderButton}" Margin="4,0,0,0"/></WrapPanel><ItemsControl ItemsSource="{Binding ImportMappings}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Element.Group}" Foreground="{DynamicResource TextSecondary}"/><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Imported canvas metric mapping"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Import mapped cards into draft" Command="{Binding ImportMappedCommand}" Style="{StaticResource HeaderButton}" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,12,0,0"><Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Reset to auto" Command="{Binding ResetToAutoCommand}" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"/></WrapPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource CritBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
    </Grid>
</Window>
