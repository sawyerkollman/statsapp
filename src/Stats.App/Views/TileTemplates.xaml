<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Stats.App.Controls"
                    xmlns:views="clr-namespace:Stats.App.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Stats.App;component/Views/Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Outer tile chrome; Width/Height follow TileSize (v1.8 UI-polish §2: S 160x80, M 224x144, L 460x192). -->
    <Style x:Key="TileBorder" TargetType="Border">
        <Setter Property="Width" Value="{Binding Size, Converter={StaticResource TileSizeToLength}, ConverterParameter=W}"/>
        <Setter Property="Height" Value="{Binding Size, Converter={StaticResource TileSizeToLength}, ConverterParameter=H}"/>
        <Setter Property="Background" Value="{DynamicResource TileBg}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Screen-reader label for the whole tile (v1.8 §11b) — value+severity are read out even though the
             glyph/colour cues below are visual-only. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationLabel}"/>
    </Style>

    <Style x:Key="TileName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeValue}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- Unit next to the value (v1.8 §2/§4) — always its own TextBlock bound to UnitText, never split out of a
         formatted string. Baseline-aligned to the value via Bottom + a small bottom margin (simplest option that
         reads correctly next to the SemiBold value without a Baseline-aligned Grid). -->
    <Style x:Key="TileUnit" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="4,0,0,3"/>
    </Style>
    <!-- Quiet footer/detail text (min/max, limit, scale labels) — FontSizeDense per v1.8 §4. -->
    <Style x:Key="TileFoot" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDense}"/>
    </Style>
    <!-- Same as TileFoot but collapses instead of leaving an empty row when the bound text is "" (v1.8 §4:
         "omit empty optional content from layout instead of leaving blank rows") — used for LimitText/MinMaxText
         and any other directly-bound (unformatted) optional string. -->
    <Style x:Key="TileOptionalText" TargetType="TextBlock" BasedOn="{StaticResource TileFoot}">
        <!-- A long footer ("min 4772 MHz   avg 4850 MHz   max 4927 MHz") ellipsizes in a medium tile instead of
             clipping mid-glyph; the tooltip carries the full text. -->
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Non-colour severity indicator next to the value (v1.8 §11b) — "" at Normal never shows, so it never
         steals layout space when nothing is wrong. -->
    <Style x:Key="TileSeverityGlyph" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding SeverityGlyph}"/>
        <Setter Property="Foreground" Value="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SeverityGlyph}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Gauge's compact arc box: ~56 units at M, larger at L (v1.8 §4 "compact arc beside it"). -->
    <Style x:Key="TileGaugeArcBox" TargetType="Grid">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Size}" Value="L">
                <Setter Property="Width" Value="88"/>
                <Setter Property="Height" Value="88"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Hover/keyboard-focus tile menu button (v1.8 §7b) — collapsed until the tile's Border is hovered or the
         tile's container (the ItemsControl's ContentPresenter — see DashboardWindow's ItemContainerStyle) has
         keyboard focus within it, so Tab/Shift+F10 access works without a permanently-visible button competing
         with the tile's own content. Sits in a reserved 24-unit grid column in every template's header row (v1.8
         §4) so appearing/disappearing never covers the label or reflows anything horizontally. Opens the same
         menu as right-click via DashboardWindow.OpenTileMenu, reached through the Button.Click EventSetter on
         that ItemContainerStyle (this ResourceDictionary has no code-behind of its own to host a Click handler
         directly). Not a Tab stop itself — Shift+F10/Apps already reaches the menu once the tile container has
         focus, so this button would only be a redundant extra stop. -->
    <Style x:Key="TileMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
        <Setter Property="Content" Value="Tile options"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Style="{StaticResource IconGlyph}" Data="{StaticResource Icon.More}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="AutomationProperties.Name" Value="Tile options"/>
        <Setter Property="ToolTip" Value="Tile options"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=IsKeyboardFocusWithin}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- S: name + value only, no chart/footer (v1.8 §4 "Compact") -->
    <DataTemplate x:Key="TileCompact">
        <Border Style="{StaticResource TileBorder}" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TileName}" ToolTip="{Binding DisplayName}"/>
                    <Button Grid.Column="1" x:Name="TileMenuButton" Style="{StaticResource TileMenuButtonStyle}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}" FontSize="{StaticResource FontSizeValueCompact}"/>
                    <TextBlock Text="{Binding UnitText}" Style="{StaticResource TileUnit}"/>
                    <TextBlock Style="{StaticResource TileSeverityGlyph}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Sparkline (default) -->
    <DataTemplate x:Key="TileSparkline">
        <Border Style="{StaticResource TileBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TileName}" ToolTip="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="1" Text="{Binding HistoryWindowTag}" Style="{StaticResource TileFoot}" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="TileMenuButton" Style="{StaticResource TileMenuButtonStyle}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MinMaxText}" Style="{StaticResource TileOptionalText}"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}"/>
                    <TextBlock Text="{Binding UnitText}" Style="{StaticResource TileUnit}"/>
                    <TextBlock Style="{StaticResource TileSeverityGlyph}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding LimitText}" Style="{StaticResource TileOptionalText}"/>
                <controls:Sparkline Values="{Binding HistoryValues}" Unit="{Binding Unit}" Capacity="{Binding HistoryCapacity}"
                                    Stroke="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=accent}"
                                    Margin="0,4"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Gauge: reading lives OUTSIDE the arc at the standard reading size (v1.8 §4); the arc is compact
         (~56 for M, larger for L via TileGaugeArcBox) supporting content beside it. -->
    <DataTemplate x:Key="TileGauge">
        <Border Style="{StaticResource TileBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TileName}" ToolTip="{Binding DisplayName}"/>
                    <Button Grid.Column="1" x:Name="TileMenuButton" Style="{StaticResource TileMenuButtonStyle}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MinMaxText}" Style="{StaticResource TileOptionalText}"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Style="{StaticResource TileGaugeArcBox}" VerticalAlignment="Center">
                        <controls:ArcGauge Fraction="{Binding Fraction01}" Thickness="8"
                                           Stroke="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=accent}"
                                           Track="{DynamicResource GaugeTrack}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}"/>
                            <TextBlock Text="{Binding UnitText}" Style="{StaticResource TileUnit}"/>
                            <TextBlock Style="{StaticResource TileSeverityGlyph}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource TileOptionalText}"/>
                        <TextBlock Text="{Binding MaxText, StringFormat='{}max {0}'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TileOptionalText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MaxText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Bar -->
    <DataTemplate x:Key="TileBar">
        <Border Style="{StaticResource TileBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TileName}" ToolTip="{Binding DisplayName}"/>
                    <Button Grid.Column="1" x:Name="TileMenuButton" Style="{StaticResource TileMenuButtonStyle}"/>
                </Grid>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}"/>
                    <TextBlock Text="{Binding UnitText}" Style="{StaticResource TileUnit}"/>
                    <TextBlock Style="{StaticResource TileSeverityGlyph}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MinMaxText}" Style="{StaticResource TileOptionalText}"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxText}" Style="{StaticResource TileOptionalText}"/>
                    <TextBlock Text="0" Style="{StaticResource TileFoot}"/>
                </DockPanel>
                <controls:LevelBar Height="10" VerticalAlignment="Bottom" Fraction="{Binding Fraction01}"
                                   Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=accent}"
                                   Track="{DynamicResource GaugeTrack}"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Value: prominent reading, optional limit, footer (v1.8 §4) -->
    <DataTemplate x:Key="TileValueTemplate">
        <Border Style="{StaticResource TileBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TileName}" ToolTip="{Binding DisplayName}"/>
                    <Button Grid.Column="1" x:Name="TileMenuButton" Style="{StaticResource TileMenuButtonStyle}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MinMaxText}" Style="{StaticResource TileOptionalText}"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding LimitText}" Style="{StaticResource TileOptionalText}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource TileValue}"/>
                    <TextBlock Text="{Binding UnitText}" Style="{StaticResource TileUnit}"/>
                    <TextBlock Style="{StaticResource TileSeverityGlyph}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <views:TileTemplateSelector x:Key="TileSelector"
                                Compact="{StaticResource TileCompact}"
                                Sparkline="{StaticResource TileSparkline}"
                                Gauge="{StaticResource TileGauge}"
                                Bar="{StaticResource TileBar}"
                                Value="{StaticResource TileValueTemplate}"/>
</ResourceDictionary>
