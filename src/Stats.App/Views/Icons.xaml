<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Shared 16x16 vector icon set (DESIGN.md §2 "Use a consistent 16-unit vector icon set... Prefer local
         XAML geometries in one resource dictionary; no emoji or downloaded icon-font dependency"). Merged in
         App.xaml/PreviewApp.cs immediately after Theme.xaml (before Controls.xaml, which needs StaticResource
         access to Icon.ChevronRight for the Expander toggle). Not theme-tinted — geometries never change with
         the active preset, so plain StaticResource is correct here (unlike the 11 palette brushes); a consumer
         colors the shape via IconGlyph's Fill (Controls.xaml), which IS a DynamicResource against TextPrimary.

         Each geometry is drawn in a 0,0,16,16 box as simple filled paths (no strokes — IconGlyph fills, never
         strokes) and marked po:Freeze so the XAML compiler freezes the instance at load (never mutated, safe to
         share across every consumer). The path-markup "F1 " prefix requests FillRule=Nonzero for icons that
         deliberately union overlapping figures into a solid shape; icons that punch a hole (a ring, or a glyph
         cut out of a solid disc) rely on the mini-language's EvenOdd default and omit the prefix. -->

    <!-- T4 dashboard toolbar action group -->
    <Geometry x:Key="Icon.Overlay" po:Freeze="True">F1 M2,3 L10,3 L10,11 L2,11 Z M6,6 L14,6 L14,14 L6,14 Z</Geometry>
    <Geometry x:Key="Icon.Fans" po:Freeze="True">F1 M5,8 A3,3 0 1 0 11,8 A3,3 0 1 0 5,8 Z M8,1 L10,5 L6,5 Z M8,15 L10,11 L6,11 Z M1,8 L5,6 L5,10 Z M15,8 L11,6 L11,10 Z</Geometry>
    <Geometry x:Key="Icon.Peaks" po:Freeze="True">F1 M1,13 L5,5 L8,9 L11,3 L15,13 Z</Geometry>
    <!-- T4 dashboard toolbar action group (Metrics) -->
    <Geometry x:Key="Icon.Metrics" po:Freeze="True">F1 M2,14 L5,14 L5,9 L2,9 Z M6.5,14 L9.5,14 L9.5,5 L6.5,5 Z M11,14 L14,14 L14,11 L11,11 Z</Geometry>
    <!-- T4 dashboard toolbar action group (Settings) -->
    <Geometry x:Key="Icon.Settings" po:Freeze="True">F1 M2,3.5 L14,3.5 L14,4.5 L2,4.5 Z M8.5,1.5 L11.5,1.5 L11.5,6.5 L8.5,6.5 Z M2,7.5 L14,7.5 L14,8.5 L2,8.5 Z M4.5,5.5 L7.5,5.5 L7.5,10.5 L4.5,10.5 Z M2,11.5 L14,11.5 L14,12.5 L2,12.5 Z M9.5,9.5 L12.5,9.5 L12.5,14.5 L9.5,14.5 Z</Geometry>
    <!-- T4 compact "View" toolbar menu (Collapse all / Expand all) -->
    <Geometry x:Key="Icon.View" po:Freeze="True">F1 M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z</Geometry>
    <!-- T4 section headers / Expander toggle (also used, rotated, by StatsExpanderToggle below); T6 sources expander -->
    <Geometry x:Key="Icon.ChevronDown" po:Freeze="True">F1 M3,5 L13,5 L8,12 Z</Geometry>
    <Geometry x:Key="Icon.ChevronRight" po:Freeze="True">F1 M5,3 L12,8 L5,13 Z</Geometry>
    <!-- T4 flyout close affordance -->
    <Geometry x:Key="Icon.Close" po:Freeze="True">F1 M3,4.5 L4.5,3 L13,11.5 L11.5,13 Z M11.5,3 L13,4.5 L4.5,13 L3,11.5 Z</Geometry>
    <!-- T4 picker search box -->
    <Geometry x:Key="Icon.Search" po:Freeze="True">M1,6 A5,5 0 1 0 11,6 A5,5 0 1 0 1,6 Z M3,6 A3,3 0 1 0 9,6 A3,3 0 1 0 3,6 Z M10.2,10.2 L11.6,8.8 L15,12.2 L13.6,13.6 Z</Geometry>
    <!-- T4 picker search "clear" action -->
    <Geometry x:Key="Icon.Clear" po:Freeze="True">M2,8 A6,6 0 1 0 14,8 A6,6 0 1 0 2,8 Z M5.5,6.8 L6.8,5.5 L10.5,9.2 L9.2,10.5 Z M9.2,5.5 L10.5,6.8 L6.8,10.5 L5.5,9.2 Z</Geometry>
    <!-- T3 tile menu "more" affordance -->
    <Geometry x:Key="Icon.More" po:Freeze="True">F1 M2.7,8 A1.3,1.3 0 1 0 5.3,8 A1.3,1.3 0 1 0 2.7,8 Z M6.7,8 A1.3,1.3 0 1 0 9.3,8 A1.3,1.3 0 1 0 6.7,8 Z M10.7,8 A1.3,1.3 0 1 0 13.3,8 A1.3,1.3 0 1 0 10.7,8 Z</Geometry>
    <!-- Severity glyphs (DESIGN.md §2 "keep warn/critical severity glyphs alongside color") -->
    <Geometry x:Key="Icon.Warn" po:Freeze="True">M8,1.5 L15,14.5 L1,14.5 Z M7.3,6 L8.7,6 L8.7,10.5 L7.3,10.5 Z M7.1,12.5 A0.9,0.9 0 1 0 8.9,12.5 A0.9,0.9 0 1 0 7.1,12.5 Z</Geometry>
    <!-- T4/T6 informational notices -->
    <Geometry x:Key="Icon.Info" po:Freeze="True">M1.5,8 A6.5,6.5 0 1 0 14.5,8 A6.5,6.5 0 1 0 1.5,8 Z M7,5 A1,1 0 1 0 9,5 A1,1 0 1 0 7,5 Z M7.2,7.5 L8.8,7.5 L8.8,11.5 L7.2,11.5 Z</Geometry>
    <!-- T6 fan card "Identify" -->
    <Geometry x:Key="Icon.Identify" po:Freeze="True">M1.5,8 A6.5,6.5 0 1 0 14.5,8 A6.5,6.5 0 1 0 1.5,8 Z M3.5,8 A4.5,4.5 0 1 0 12.5,8 A4.5,4.5 0 1 0 3.5,8 Z M6.5,8 A1.5,1.5 0 1 0 9.5,8 A1.5,1.5 0 1 0 6.5,8 Z</Geometry>
    <!-- Tile-resize-by-drag: bottom-right resize grip glyph — six dots on the diagonal (a 1/2/3 triangular stack),
         drawn in a 12x12 box (TileResizeGripStyle's Path is sized 12x12 within the 14x14 grip border). -->
    <Geometry x:Key="Icon.ResizeGrip" po:Freeze="True">F1 M8.9,10 A1.1,1.1 0 1 0 11.1,10 A1.1,1.1 0 1 0 8.9,10 Z M4.9,10 A1.1,1.1 0 1 0 7.1,10 A1.1,1.1 0 1 0 4.9,10 Z M8.9,6 A1.1,1.1 0 1 0 11.1,6 A1.1,1.1 0 1 0 8.9,6 Z M0.9,10 A1.1,1.1 0 1 0 3.1,10 A1.1,1.1 0 1 0 0.9,10 Z M4.9,6 A1.1,1.1 0 1 0 7.1,6 A1.1,1.1 0 1 0 4.9,6 Z M8.9,2 A1.1,1.1 0 1 0 11.1,2 A1.1,1.1 0 1 0 8.9,2 Z</Geometry>

</ResourceDictionary>
