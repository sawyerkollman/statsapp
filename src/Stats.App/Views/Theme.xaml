<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Stats.App.Converters">

    <!-- Shared primitives. Merged by BOTH App.xaml and TileTemplates.xaml — a StaticResource inside a merged
         dictionary cannot see the dictionary that merged it, so anything referenced from TileTemplates.xaml must
         live here rather than in App.xaml. This means Theme.xaml is instantiated as TWO DISTINCT
         ResourceDictionary/Freezable instances at runtime (App.xaml's copy and TileTemplates.xaml's copy) — the
         SolidColorBrush objects below are NOT shared between them. Live theme switching therefore cannot mutate
         those brush instances directly (and can't anyway: a ResourceDictionary freezes/seals every Freezable it
         owns once merged, so `brush.Color = ...` throws). Instead each brush's Color is a DynamicResource
         pointing at a *Color* resource (a Freezable that holds a DynamicResourceExtension has CanFreeze==false,
         so it is never sealed). ThemeManager.Apply sets the Color resources directly on the TOP-LEVEL
         Application.Current.Resources, which shadows the Color entries declared below for every DynamicResource
         lookup — including from inside TileTemplates.xaml's separate copy of this dictionary — so both physical
         brush instances stay in sync without ever being mutated or replaced. -->

    <!-- Palette colours (theme-tinted; ThemeManager.Apply overrides these at the top level) -->
    <Color x:Key="WindowBgColor">#FF1B1B1C</Color>
    <Color x:Key="TileBgColor">#FF252528</Color>
    <Color x:Key="FlyoutBgColor">#FF2B2B2F</Color>
    <Color x:Key="ControlBgColor">#FF303035</Color>
    <Color x:Key="BorderDimColor">#FF3A3A40</Color>
    <Color x:Key="TextPrimaryColor">#FFF0F0F0</Color>
    <Color x:Key="TextSecondaryColor">#FF9A9A9E</Color>
    <Color x:Key="AccentColor">#FFE68A2E</Color>
    <Color x:Key="WarnColor">#FFE6A23C</Color>
    <Color x:Key="CritColor">#FFE05A4F</Color>
    <Color x:Key="GaugeTrackColor">#FF3A3A40</Color>

    <!-- Fixed, not theme-tinted: the overlay panel is always a dark translucent surface (readable text on it
         regardless of the active preset), so these two are pinned to the Dark palette's text colours in every
         preset rather than routed through ThemeManager.Apply. -->
    <Color x:Key="OverlayTextPrimaryColor">#FFF0F0F0</Color>
    <Color x:Key="OverlayTextSecondaryColor">#FF9A9A9E</Color>

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBg" Color="{DynamicResource WindowBgColor}"/>
    <SolidColorBrush x:Key="TileBg" Color="{DynamicResource TileBgColor}"/>
    <SolidColorBrush x:Key="FlyoutBg" Color="{DynamicResource FlyoutBgColor}"/>
    <SolidColorBrush x:Key="ControlBg" Color="{DynamicResource ControlBgColor}"/>
    <SolidColorBrush x:Key="BorderDim" Color="{DynamicResource BorderDimColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{DynamicResource WarnColor}"/>
    <SolidColorBrush x:Key="CritBrush" Color="{DynamicResource CritColor}"/>
    <SolidColorBrush x:Key="GaugeTrack" Color="{DynamicResource GaugeTrackColor}"/>
    <SolidColorBrush x:Key="OverlayTextPrimary" Color="{DynamicResource OverlayTextPrimaryColor}"/>
    <SolidColorBrush x:Key="OverlayTextSecondary" Color="{DynamicResource OverlayTextSecondaryColor}"/>

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    <conv:TileSizeToLengthConverter x:Key="TileSizeToLength"/>
    <conv:HeatToBrushConverter x:Key="HeatToBrush"/>
    <conv:HeatToForegroundConverter x:Key="HeatToForeground"/>
    <conv:HexToBrushConverter x:Key="HexToBrush"/>
    <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    <conv:EqualsConverter x:Key="Equals"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:OverlayOrientationConverter x:Key="OverlayOrientation"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

</ResourceDictionary>
