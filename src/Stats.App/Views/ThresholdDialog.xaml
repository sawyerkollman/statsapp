<Window x:Class="Stats.App.Views.ThresholdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thresholds" Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource FlyoutBg}">
    <StackPanel Margin="16">
        <TextBlock x:Name="MetricNameText" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock x:Name="WarnLabel" Text="Warn" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="WarnBox" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock x:Name="CritLabel" Text="Crit" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="CritBox" FontSize="13"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="DirectionNote" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                   FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <CheckBox x:Name="LowerIsWorseCheck" Content="Lower is worse" Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource CritBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Clear" Click="Clear_Click" Style="{StaticResource HeaderButton}" MinWidth="60"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource HeaderButton}" MinWidth="70"/>
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Style="{StaticResource HeaderButton}" MinWidth="70"/>
        </StackPanel>
    </StackPanel>
</Window>
