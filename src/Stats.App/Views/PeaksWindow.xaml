<Window x:Class="Stats.App.Views.PeaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats — Session peaks" Width="640" Height="480" MinWidth="480" MinHeight="240"
        Background="{DynamicResource WindowBg}">
    <TabControl Margin="12">

        <!-- ============ Peaks ============ -->
        <TabItem Header="Peaks">
            <DockPanel Margin="0,8,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Reset session" Command="{Binding ResetSessionCommand}" Style="{StaticResource HeaderButton}"/>
                    <Button DockPanel.Dock="Right" Content="Copy" Click="Copy_Click" Style="{StaticResource HeaderButton}" Margin="0,0,8,0"/>
                    <CheckBox DockPanel.Dock="Right" Content="All metrics" IsChecked="{Binding IncludeAll}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Session peaks" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CopyError}" Foreground="{DynamicResource CritBrush}" FontSize="{StaticResource FontSizeDense}"
                           Margin="0,0,0,6" Visibility="{Binding HasCopyError, Converter={StaticResource BoolToVis}}"/>
                <Grid>
                    <TextBlock Text="No metrics selected yet — add some from the dashboard's Metrics panel"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="360">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Metric" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="1" Text="Now" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Min" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Avg" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Max" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TileBg}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition.DisplayName}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NowText}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MinText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{Binding MinAtText}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AvgText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MaxText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{Binding MaxAtText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ Alerts ============ -->
        <TabItem Header="Alerts">
            <DockPanel Margin="0,8,0,0" DataContext="{Binding AlertLog}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource HeaderButton}"/>
                    <TextBlock Text="Alert log" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <Grid>
                    <TextBlock Text="No alerts this session"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="1" Text="Metric" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="2" Text="Peak" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Threshold" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Duration" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TileBg}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding MetricText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PeakText}" Foreground="{DynamicResource CritBrush}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ThresholdText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

    </TabControl>
</Window>
