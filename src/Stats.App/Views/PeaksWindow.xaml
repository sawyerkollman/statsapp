<Window x:Class="Stats.App.Views.PeaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:proc="clr-namespace:Stats.Core.Processes;assembly=Stats.Core"
        Title="Stats — Session peaks" Width="640" Height="480" MinWidth="480" MinHeight="240"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <Style x:Key="ColumnHeaderButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="Padding" Value="4,1"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeDense}"/><Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <TabControl Margin="12">

        <!-- ============ Peaks ============ -->
        <TabItem Header="Peaks">
            <DockPanel Margin="0,8,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Reset session" Command="{Binding ResetSessionCommand}" Style="{StaticResource HeaderButton}"/>
                    <Button DockPanel.Dock="Right" Content="Copy" Click="Copy_Click" Style="{StaticResource HeaderButton}" Margin="0,0,8,0"/>
                    <CheckBox DockPanel.Dock="Right" Content="All metrics" IsChecked="{Binding IncludeAll}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Session peaks" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CopyError}" Foreground="{DynamicResource CritBrush}" FontSize="{StaticResource FontSizeDense}"
                           Margin="0,0,0,6" Visibility="{Binding HasCopyError, Converter={StaticResource BoolToVis}}"/>
                <Grid>
                    <TextBlock Text="No metrics selected yet — add some from the dashboard's Metrics panel"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="360">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DockPanel Grid.IsSharedSizeScope="True"
                                   Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                   MinWidth="428">
                            <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakNow"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakMin"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakAvg"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakMax"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Metric" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="1" Text="Now" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Min" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Avg" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Max" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TileBg}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakNow"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakMin"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakAvg"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="PeakMax"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition.DisplayName}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NowText}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" TextAlignment="Right" Typography.NumeralAlignment="Tabular"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MinText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{Binding MinAtText}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AvgText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MaxText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" ToolTip="{Binding MaxAtText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ Alerts ============ -->
        <TabItem Header="Alerts">
            <DockPanel Margin="0,8,0,0" DataContext="{Binding AlertLog}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource HeaderButton}"/>
                    <TextBlock Text="Alert log" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryStatus}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Grid>
                    <TextBlock Text="No saved alerts"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <DockPanel Grid.IsSharedSizeScope="True"
                                   Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                   MinWidth="428">
                            <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertTime"/>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertPeak"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertThreshold"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertDuration"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="1" Text="Metric" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                <TextBlock Grid.Column="2" Text="Peak" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Threshold" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Duration" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource TileBg}" CornerRadius="4" Padding="6,4" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertTime"/>
                                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertPeak"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertThreshold"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="AlertDuration"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeText}" ToolTip="{Binding RaisedAtText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}"/>
                                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding MetricText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="View context" Style="{StaticResource HeaderButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                            Visibility="{Binding Context, Converter={StaticResource NullToVis}}"
                                                            Command="{Binding DataContext.OpenContextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PeakText}" Foreground="{DynamicResource CritBrush}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ThresholdText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Processes">
            <DockPanel Margin="0,8,0,0" DataContext="{Binding Processes}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4"><Button DockPanel.Dock="Right" Content="Copy" Click="CopyProcesses_Click" Style="{StaticResource HeaderButton}"/><TextBlock Text="Top processes" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}" Margin="0,0,0,6" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CopyError}" Foreground="{DynamicResource CritBrush}" FontSize="{StaticResource FontSizeDense}" Margin="0,0,0,6" Visibility="{Binding HasCopyError, Converter={StaticResource BoolToVis}}"/>
                <Grid>
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><DockPanel Grid.IsSharedSizeScope="True" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="428">
                        <Grid DockPanel.Dock="Top" Margin="6,0,6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ProcCpu"/><ColumnDefinition Width="Auto" SharedSizeGroup="ProcGpu"/><ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ProcMem"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeDense}"/>
                            <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="{x:Static proc:ProcessSortColumn.Cpu}" ToolTip="Sort by CPU" AutomationProperties.Name="Sort by CPU"><StackPanel Orientation="Horizontal"><TextBlock Text="▼" Margin="0,0,3,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsSortedByCpu, Converter={StaticResource BoolToVis}}"/><TextBlock Text="CPU %"/></StackPanel></Button>
                            <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="{x:Static proc:ProcessSortColumn.Gpu}" ToolTip="Sort by GPU" AutomationProperties.Name="Sort by GPU" Visibility="{Binding IsGpuAvailable, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal" MinWidth="72"><TextBlock Text="▼" Margin="0,0,3,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsSortedByGpu, Converter={StaticResource BoolToVis}}"/><TextBlock Text="GPU %"/></StackPanel></Button>
                            <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}" CommandParameter="{x:Static proc:ProcessSortColumn.Memory}" ToolTip="Sort by memory" AutomationProperties.Name="Sort by memory"><StackPanel Orientation="Horizontal"><TextBlock Text="▼" Margin="0,0,3,0" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsSortedByMemory, Converter={StaticResource BoolToVis}}"/><TextBlock Text="Memory"/></StackPanel></Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource TileBg}" CornerRadius="4" Padding="6,4" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140"/><ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ProcCpu"/><ColumnDefinition Width="Auto" SharedSizeGroup="ProcGpu"/><ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="ProcMem"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding NameToolTip}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding CpuText}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" FontWeight="SemiBold" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="2" Text="{Binding GpuText}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" MinWidth="72" Visibility="{Binding DataContext.IsGpuAvailable, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/><TextBlock Grid.Column="3" Text="{Binding MemoryText}" ToolTip="{Binding MemoryToolTip}" Foreground="{DynamicResource TextPrimary}" FontSize="{StaticResource FontSizeLabel}" TextAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </DockPanel></ScrollViewer>
                </Grid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
