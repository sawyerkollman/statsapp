<UserControl x:Class="Stats.App.Views.CoreMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Margin="6" means this Border — and therefore the size SetCoreMatrixSize reports — renders 6 px right/below
         its Canvas.Left/Top, so "drop the block at x=0" in Free/Snap is not flush with a tile dropped at x=0. -->
    <Border Background="{DynamicResource TileBg}" CornerRadius="{StaticResource RadiusPanel}" Margin="6" Padding="12" HorizontalAlignment="Left">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Cores — load · clock · temp"
                       Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontSizeLabel}"/>
            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="60" Height="64" Margin="2" CornerRadius="3"
                                Background="{Binding Load01, Converter={StaticResource HeatToBrush}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Index, StringFormat='{}#{0}'}" FontSize="{StaticResource FontSizeDense}"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LoadText}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{Binding Load01, Converter={StaticResource HeatToForeground}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ClockText}" FontSize="{StaticResource FontSizeDense}"
                                           Foreground="{Binding Load01, Converter={StaticResource HeatToForeground}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TempText}" FontSize="{StaticResource FontSizeDense}"
                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
