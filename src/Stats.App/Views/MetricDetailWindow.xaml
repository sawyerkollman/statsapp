<Window x:Class="Stats.App.Views.MetricDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Stats.App.Controls"
        Title="Stats — Metric detail" Width="640" Height="420" MinWidth="480" MinHeight="300"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding CurrentText}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"
                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12">
                <Run Text="min "/><Run Text="{Binding MinText, Mode=OneWay}"/>
                <Run Text="   avg "/><Run Text="{Binding AvgText, Mode=OneWay}"/>
                <Run Text="   max "/><Run Text="{Binding MaxText, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>
        <ctl:HistoryChart Values="{Binding Values}" Unit="{Binding Unit}" HoverTextProvider="{Binding HoverTextProvider}" SecondsPerSample="{Binding SecondsPerSample}"
                          WarnValue="{Binding WarnValue}" CritValue="{Binding CritValue}"
                          TimeAxisLabels="{Binding TimeAxisLabels}" YAxisLabels="{Binding YAxisLabels}"
                          Stroke="{Binding Severity, Converter={StaticResource SeverityToBrush}, ConverterParameter=accent}"/>
    </DockPanel>
</Window>
