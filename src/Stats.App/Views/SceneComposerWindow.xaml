<Window x:Class="Stats.App.Views.SceneComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stats — Scene composer" Width="620" Height="680" MinWidth="500" MinHeight="400"
        Background="{DynamicResource WindowBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Scene composer" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Scenes capture dashboard arrangement and overlay appearance. Metric selection remains on the dashboard." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="Saved scenes" Foreground="{DynamicResource TextSecondary}"/>
            <ComboBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" DisplayMemberPath="Name" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal"><Button Content="Apply" Command="{Binding ApplySelectedCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Delete…" Click="Delete_Click" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"/><Button Content="Export…" Click="Export_Click" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"/><Button Content="Import…" Click="Import_Click" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"/></StackPanel>
            <Separator Margin="0,14"/>
            <TextBlock Text="Save current scene" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Scene name" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,4,0,0" AutomationProperties.Name="Scene name"/>
            <TextBlock Text="Private scene notes (not exported)" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
            <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Margin="0,4,0,0" AutomationProperties.Name="Scene notes"/>
            <CheckBox Content="Vertical overlay" IsChecked="{Binding OverlayVertical}" Margin="0,8,0,0"/>
            <Expander Header="Section labels (Auto layout)" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="Blank keeps the group name. Labels are shared in exported scenes; private notes are not. Groups and metric order are preserved." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SectionLabels}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="{Binding Group}"/>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Expander>
            <CheckBox Content="Overlay sparklines" IsChecked="{Binding OverlaySparklines}" Margin="0,4,0,0"/>
            <TextBlock Text="Overlay scale" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/><Slider Minimum="0.8" Maximum="1.6" Value="{Binding OverlayScale}"/>
            <TextBlock Text="Overlay opacity" Foreground="{DynamicResource TextSecondary}"/><Slider Minimum="0.3" Maximum="1" Value="{Binding OverlayOpacity}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Save current" Command="{Binding SaveCurrentCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Apply overlay only" Command="{Binding ApplyOverlayOnlyCommand}" Style="{StaticResource HeaderButton}" Margin="8,0,0,0"/></StackPanel>
            <ItemsControl ItemsSource="{Binding Mappings}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="Import mapped scene" Command="{Binding ImportMappedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource CritBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
